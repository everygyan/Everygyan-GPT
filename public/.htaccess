# =============================================================
# EveryGyan Production Apache Configuration (.htaccess)
# =============================================================

# Real 404 Error Document for missing URLs
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce canonical HTTPS and non-www domain
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://everygyan.com/$1 [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.everygyan\.com$ [NC]
  RewriteRule ^(.*)$ https://everygyan.com/$1 [L,R=301]

  # Allow direct access to index.html and 404.html
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^404\.html$ - [L]

  # Route valid Single Page Application (SPA) routes to index.html
  RewriteCond %{REQUEST_URI} ^/(article|category|tag|about|deals|contact|privacy|terms|search|reset-password|newsletter|unsubscribe|dashboard|admin)(/.*)?$ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]

  # All other missing resources and non-existent URLs return real HTTP 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ /404.html [R=404,L]
</IfModule>

# Gzip & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType image/x-icon .ico
  AddType image/png .png
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Production Browser Caching for Hostinger
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Production Security & AI Content-Signal Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Declare content permissions to AI agents & crawlers via HTTP headers
  Header set Content-Signal "search=yes, ai-train=no"
</IfModule>

# Allow public manifest, robots, and 404 page
<Files "site.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
<Files "robots.txt">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
<Files "404.html">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# Block web access to sensitive project files (lockfiles, env, config)
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|lock|json)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to hidden directories and node_modules if present on server
RedirectMatch 403 ^/node_modules/
RedirectMatch 403 ^/\.git
