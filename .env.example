# ==============================================================================
# EveryGyan Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development.
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your `.env` file to Git.
# 2. NEVER put your Supabase `service_role` key, database passwords, or SMTP secrets in this file.
# 3. Only client-safe public keys (e.g., Anon key) should be prefixed with `VITE_`.
# ==============================================================================

# Supabase Public Configuration (Safe for browser client)
VITE_SUPABASE_URL=https://wttiswajotrmmrcwzqdy.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Public Site Configuration
VITE_SITE_URL=https://everygyan.com
VITE_SITE_NAME=EveryGyan
VITE_SITE_TAGLINE="Knowledge for Everyone, Everywhere"

# ==============================================================================
# Server-Side & Supabase Edge Function Secrets
# Store these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets.
# NEVER commit real secret values to Git or prepend with VITE_!
# ==============================================================================
# N8N_INGEST_SECRET=generate-a-strong-random-hex-token-for-n8n-webhook-auth
# N8N_AUTHOR_ID=optional-supabase-author-profile-uuid-for-ai-drafts
